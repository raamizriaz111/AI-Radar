# AI Radar — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# No environment variables are required for Phase 1.

# ── Supabase (Phase 2) ────────────────────────────────────────────────────────
# Required when connecting the database in Phase 2.
# Get these from your Supabase project dashboard under Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# The service role key must NEVER appear in NEXT_PUBLIC_ variables or client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI Provider (Phase 4) ─────────────────────────────────────────────────────
# Provider selection: 'openai', 'gemini', or 'mock' (default fallback when no key is set).
# AI_PROVIDER=openai

# Model selection (optional override; sensible defaults are used if omitted):
# OpenAI default: gpt-4o-mini | Gemini default: gemini-1.5-flash
# AI_MODEL=gpt-4o-mini

# Provider API keys — Keep strictly server-side. NEVER expose with NEXT_PUBLIC_.
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_AI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Source APIs (Phase 3) ─────────────────────────────────────────────────────
# Optional depending on which sources are configured.
# arXiv and Hacker News have public APIs that do not require keys.
# GITHUB_TOKEN=your-github-personal-access-token
# HF_API_KEY=your-huggingface-api-token

# ── Phase 3 Collection ────────────────────────────────────────────────────────
# Optional: protects the POST /api/collect endpoint.
# In development the route works without this secret (warning is logged).
# In production this MUST be set to a strong random secret.
# COLLECTION_SECRET=your-strong-random-secret

# Optional: GitHub Personal Access Token for higher API rate limits (30 req/min vs 10).
# Unauthenticated access still works but is more rate-limited.
# GITHUB_TOKEN=your-github-personal-access-token

# ── Application ───────────────────────────────────────────────────────────────
# Base URL used when generating absolute URLs in server-side code.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Builder & System Owner ───────────────────────────────────────────────────
# Owner account granted permanent Lifetime Advanced tier & Admin permissions.
OWNER_EMAIL=raamizriaz111@gmail.com
BUILDER_EMAIL=raamizriaz111@gmail.com

# ── Lemon Squeezy Billing (Recommended for International & Pakistani Payouts) ─
# Merchant of Record (MoR) accepting global cards, PayPal, Apple Pay, Google Pay in USD
# with direct payouts to Pakistani bank accounts (via Payoneer, Wise, or international wire).
# Register your store at: https://www.lemonsqueezy.com
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
# Product Variant IDs (found in Lemon Squeezy Dashboard → Products → Share/Variant ID)
LEMONSQUEEZY_PRO_VARIANT_ID_MONTHLY=your-pro-monthly-variant-id
LEMONSQUEEZY_PRO_VARIANT_ID_ANNUAL=your-pro-annual-variant-id
LEMONSQUEEZY_ADVANCED_VARIANT_ID_MONTHLY=your-advanced-monthly-variant-id
LEMONSQUEEZY_ADVANCED_VARIANT_ID_ANNUAL=your-advanced-annual-variant-id

# ── Stripe Billing (Alternative / Optional) ───────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID_MONTHLY=price_...
# STRIPE_PRO_PRICE_ID_ANNUAL=price_...
# STRIPE_ADVANCED_PRICE_ID_MONTHLY=price_...
# STRIPE_ADVANCED_PRICE_ID_ANNUAL=price_...

